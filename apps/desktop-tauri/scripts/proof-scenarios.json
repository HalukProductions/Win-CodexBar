{
  "scenarios": [
    {
      "name": "tray-default",
      "query": "window=main&fixture=default",
      "size": [310, 1032],
      "steps": [
        { "expectText": ["Usage & Spend", "dev@example.com", "claude.user@example.com"] },
        { "screenshot": "tray-default", "clip": "panel" },
        { "click": { "selector": ".provider-grid__item", "label": "Claude" } },
        { "expectNoText": "dev@example.com" },
        { "expectText": ["claude.user@example.com", "Switch Account..."] },
        { "screenshot": "tray-claude-detail", "clip": "panel" }
      ]
    },
    {
      "name": "tray-claude-plan-renews",
      "query": "window=main&fixture=default",
      "size": [310, 1032],
      "steps": [
        { "click": { "selector": ".provider-grid__item", "label": "Claude" } },
        { "expectText": ["claude.user@example.com", "Plan renews: Dec 1, 2026"] },
        { "expectNoText": "Plan expires:" },
        { "screenshot": "tray-claude-plan-renews", "clip": "panel" }
      ]
    },
    {
      "name": "tray-claude-plan-hidden",
      "query": "window=main&fixture=claude-plan-hidden",
      "size": [310, 1032],
      "steps": [
        { "click": { "selector": ".provider-grid__item", "label": "Claude" } },
        { "expectText": "claude.user@example.com" },
        { "expectNoText": ["Plan renews", "Plan expires"] },
        { "screenshot": "tray-claude-plan-hidden", "clip": "panel" }
      ]
    },
    {
      "name": "tray-errors",
      "query": "window=main&fixture=errors",
      "size": [310, 1032],
      "steps": [
        { "expectText": ["Your Claude session has expired.", "cursor.user@example.com"] },
        { "screenshot": "tray-errors", "clip": "panel" }
      ]
    },
    {
      "name": "tray-empty",
      "query": "window=main&fixture=empty",
      "size": [310, 1032],
      "steps": [
        { "expectText": "No providers configured" },
        { "expectNoText": "@example.com" },
        { "screenshot": "tray-empty", "clip": "panel" }
      ]
    },
    {
      "name": "flyout-default",
      "query": "window=flyout&fixture=default",
      "size": [310, 1032],
      "steps": [
        { "expectText": "dev@example.com" },
        { "screenshot": "flyout-default", "clip": "panel" }
      ]
    },
    {
      "name": "settings-general-dark",
      "query": "window=settings&tab=general&theme=dark",
      "size": [880, 620],
      "steps": [
        { "expectTheme": "dark" },
        { "expectText": ["Refresh interval", "Start at login"] },
        { "screenshot": "settings-general-dark" },
        { "click": { "selector": "button", "label": "Menu" } },
        { "expectText": "Panel scale" },
        { "screenshot": "settings-menu-after-click" }
      ]
    },
    {
      "name": "settings-general-light",
      "query": "window=settings&tab=general&theme=light",
      "size": [880, 620],
      "steps": [
        { "expectTheme": "light" },
        { "expectText": "Refresh interval" },
        { "screenshot": "settings-general-light" }
      ]
    },
    {
      "name": "settings-providers",
      "query": "window=settings&tab=providers&theme=dark",
      "size": [880, 620],
      "steps": [
        { "expectText": ["Codex", "Claude"] },
        { "screenshot": "settings-providers" }
      ]
    },
    {
      "name": "settings-codex-two-accounts",
      "query": "window=settings&tab=providers:codex&fixture=two-codex-accounts&theme=dark",
      "size": [880, 620],
      "steps": [
        { "expectText": ["work@example.com", "personal@example.com"] },
        { "screenshot": "settings-codex-two-accounts" },
        { "click": { "selector": "button", "label": "Switch", "near": "personal@example.com" } },
        { "expectCall": { "cmd": "codex_account_switch", "args": { "id": "proof-codex-personal" } } }
      ]
    },
    {
      "name": "settings-menu-work-days",
      "query": "window=settings&tab=menu&theme=dark",
      "size": [880, 620],
      "steps": [
        { "expectField": { "label": "Work days", "value": "", "options": ["Automatic", "4 days", "5 days", "6 days", "7 days"] } },
        { "expectField": { "label": "Workday tick appearance", "enabled": false } },
        { "screenshot": "settings-menu-work-days-automatic" },
        { "select": { "label": "Work days", "value": "6" } },
        { "expectField": { "label": "Work days", "value": "6" } },
        { "expectField": { "label": "Workday tick appearance", "enabled": true } },
        { "expectCall": { "cmd": "update_settings", "args": { "patch": { "weeklyProgressWorkDays": 6 } } } },
        { "screenshot": "settings-menu-work-days-6" }
      ]
    },
    {
      "name": "tray-openai-live-spend",
      "query": "window=main&fixture=openai-live-spend",
      "size": [310, 1032],
      "steps": [
        { "expectText": ["OpenAI API", "Tokens per minute", "Live", "Spend"] },
        { "click": { "selector": "button", "label": "Live" } },
        { "expectSelector": ".openai-live-spend[data-mode=\"live\"] [data-testid=\"openai-spend-layer\"][aria-hidden=\"true\"]" },
        { "screenshot": "tray-openai-live", "clip": "panel" },
        { "click": { "selector": ".openai-tpm__chart", "label": "Tokens per minute" } },
        { "expectText": "requests" },
        { "expectSelector": "[data-testid=\"openai-live-layer\"] rect.openai-tpm__bar--selected" },
        { "screenshot": "tray-openai-live-inspect", "clip": "panel" },
        { "click": { "selector": "button", "label": "Spend" } },
        { "expectText": "Daily spend · Last 30 days" },
        { "expectSelector": ".openai-live-spend[data-mode=\"spend\"] [data-testid=\"openai-live-layer\"][aria-hidden=\"true\"]" },
        { "click": { "selector": ".openai-tpm__chart", "label": "Daily spend · Last 30 days" } },
        { "expectText": ": $" },
        { "expectSelector": "[data-testid=\"openai-spend-layer\"] rect.openai-tpm__bar--selected" },
        { "screenshot": "tray-openai-spend-inspect", "clip": "panel" }
      ]
    },
    {
      "name": "floatbar",
      "query": "window=floatbar",
      "size": [520, 120],
      "steps": [
        { "expectSelector": ".floatbar__pill" },
        { "expectText": "%" },
        { "screenshot": "floatbar" }
      ]
    }
  ]
}
