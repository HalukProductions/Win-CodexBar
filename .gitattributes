# Mark Swift code as vendored so GitHub shows Rust as primary language
*.swift linguist-vendored
Sources/** linguist-vendored
Tests/** linguist-vendored
Package.swift linguist-vendored

# Pi-family session fixtures are byte-exact copies of upstream wire shapes;
# never EOL-convert them (parsers split on LF).
rust/src/agent_sessions/fixtures/** -text

# Generated notices are compared byte-for-byte by `pnpm run notices:check`.
apps/desktop-tauri/src/generated/third-party-notices.json text eol=lf
apps/desktop-tauri/scripts/license-templates/*.txt text eol=lf

# Bash scripts must remain LF for Linux and WSL execution.
*.sh text eol=lf

# Upstream Claude PTY captures are byte-exact copies (they contain CR bytes); never EOL-convert them.
rust/src/providers/fixtures/claude/*.ansi -text
